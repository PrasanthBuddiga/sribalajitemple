---
interface Photo {
  url: string;
  alt: string;
}

interface Props {
  albums: {
    title: string;
    photos: Photo[];
  }[];
}

const { albums } = Astro.props;

const albumsForClient = albums.map(album => ({
  title: album.title,
  photos: album.photos.map(p => ({ url: p.url, alt: p.alt }))
}));
---

<!-- GALLERY LIGHTBOX MODAL -->
<div id="galleryLightbox" class="fixed inset-0 z-50 hidden flex items-center justify-center p-0 md:p-4" style="background: rgba(10, 10, 12, 0.9); backdrop-filter: blur(16px);" data-albums={JSON.stringify(albumsForClient)}>
  <button onclick="closeGallery()" class="absolute top-4 right-4 z-10 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/10 backdrop-blur-md text-white hover:bg-white/20 hover:scale-110 flex items-center justify-center font-bold transition-all duration-300 border border-white/20 shadow-lg">
    ✕
  </button>
  
  <button onclick="prevPhoto()" class="absolute left-2 md:left-4 z-10 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/10 backdrop-blur-md text-white hover:bg-white/20 hover:scale-110 flex items-center justify-center font-bold transition-all duration-300 border border-white/20 shadow-lg">
    ←
  </button>
  
  <button onclick="nextPhoto()" class="absolute right-2 md:right-4 z-10 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/10 backdrop-blur-md text-white hover:bg-white/20 hover:scale-110 flex items-center justify-center font-bold transition-all duration-300 border border-white/20 shadow-lg">
    →
  </button>
  
  <div class="max-w-5xl w-full h-full md:h-auto flex flex-col items-center justify-center">
    <p id="galleryAlbumTitle" class="text-center text-white/90 text-xs md:text-sm font-medium mb-3"></p>
    <img id="galleryImage" src="" alt="" class="max-w-full max-h-[85vh] w-auto h-auto object-contain rounded-lg shadow-2xl" />
    <p id="galleryCounter" class="text-center text-white/70 text-xs md:text-sm mt-4"></p>
  </div>
</div>

<script is:inline>
  /** @type {Array<{url: string, alt: string}>} */
  let currentPhotos = [];
  let currentIndex = 0;

  /**
   * @param {number} index
   * @param {string} albumTitle
   */
  function openGallery(index, albumTitle) {
    const lightboxEl = document.getElementById('galleryLightbox');
    if (!lightboxEl?.dataset.albums) return;
    
    const albumsData = JSON.parse(lightboxEl.dataset.albums);
    const album = albumsData.find((/** @type {{title: string}} */ a) => a.title === albumTitle);
    if (!album) return;
    
    currentPhotos = album.photos;
    currentIndex = index;
    
    updateLightbox();
    lightboxEl.classList.remove('hidden');
  }

  function closeGallery() {
    const lightboxEl = document.getElementById('galleryLightbox');
    if (lightboxEl) {
      lightboxEl.classList.add('hidden');
    }
  }

  function nextPhoto() {
    currentIndex = (currentIndex + 1) % currentPhotos.length;
    updateLightbox();
  }

  function prevPhoto() {
    currentIndex = (currentIndex - 1 + currentPhotos.length) % currentPhotos.length;
    updateLightbox();
  }

  function updateLightbox() {
    const photo = currentPhotos[currentIndex];
    const imgEl = /** @type {HTMLImageElement} */ (document.getElementById('galleryImage'));
    const counterEl = document.getElementById('galleryCounter');
    
    if (imgEl) {
      imgEl.src = photo.url;
      imgEl.alt = photo.alt;
    }
    if (counterEl) {
      counterEl.textContent = `${currentIndex + 1} / ${currentPhotos.length}`;
    }
  }

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    const lightbox = document.getElementById('galleryLightbox');
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    
    if (e.key === 'Escape') closeGallery();
    if (e.key === 'ArrowRight') nextPhoto();
    if (e.key === 'ArrowLeft') prevPhoto();
  });
</script>
