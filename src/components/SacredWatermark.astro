---
interface Props {
  className?: string;
}

const { className = "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[32rem] md:w-[40rem] opacity-[0.05] pointer-events-none -z-10" } = Astro.props;
---

<div class={className}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 220" class="w-full h-full">
    <!-- LEFT: Sudarshana Chakra (Discus) -->
    <g transform="translate(110, 110)" stroke="#B8860B" fill="none" stroke-width="4">
      <!-- Outer Flame/Spikes -->
      <g fill="#D4AF37" stroke="none">
        <polygon points="0,-78 -6,-62 6,-62" />
        <polygon points="0,78 -6,62 6,62" />
        <polygon points="-78,0 -62,-6 -62,6" />
        <polygon points="78,0 62,-6 62,6" />
        <polygon points="-55,-55 -48,-39 -39,-48" />
        <polygon points="55,-55 48,-39 39,-48" />
        <polygon points="-55,55 -48,39 -39,48" />
        <polygon points="55,55 48,39 39,48" />
      </g>
      <!-- Main Rings -->
      <circle cx="0" cy="0" r="60" stroke-width="6" />
      <circle cx="0" cy="0" r="46" stroke-width="2" />
      <circle cx="0" cy="0" r="14" fill="#D4AF37" />
      <!-- Spokes -->
      <line x1="0" y1="-46" x2="0" y2="46" stroke-width="3" />
      <line x1="-46" y1="0" x2="46" y2="0" stroke-width="3" />
      <line x1="-32.5" y1="-32.5" x2="32.5" y2="32.5" stroke-width="3" />
      <line x1="-32.5" y1="32.5" x2="32.5" y2="-32.5" stroke-width="3" />
      <!-- Side Tassels -->
      <path d="M -60,0 Q -78,15 -72,40" stroke-width="3" />
      <path d="M 60,0 Q 78,15 72,40" stroke-width="3" />
      <!-- Base Pedestal -->
      <path d="M -25,65 L 25,65 L 35,80 L -35,80 Z" fill="#D4AF37" stroke="none" />
    </g>

    <!-- CENTER: Thirunamam -->
    <g transform="translate(300, 110)">
      <!-- Outer U-shape (Thiruman) -->
      <path d="M -42,-65 L -24,-65 L -24,25 C -24,42 -12,50 0,50 C 12,50 24,42 24,25 L 24,-65 L 42,-65 L 42,25 C 42,56 22,68 0,68 C -22,68 -42,56 -42,25 Z" 
            fill="#FFFFFF" stroke="#B8860B" stroke-width="4" stroke-linejoin="round" />
      <!-- Center Flame/Line (Sricharanam) -->
      <path d="M 0,-60 L 9,28 C 9,34 5,38 0,38 C -5,38 -9,34 -9,28 Z" 
            fill="#C8102E" />
      <!-- Base Pedestal -->
      <path d="M -30,72 L 30,72 L 40,85 L -40,85 Z" fill="#D4AF37" />
    </g>

    <!-- RIGHT: Panchajanya Shanku (Conch) -->
    <g transform="translate(490, 110)" stroke="#B8860B" fill="none" stroke-width="4" stroke-linejoin="round">
      <!-- Crown / Top Tip -->
      <path d="M -12,-58 L 0,-75 L 12,-58 Z" fill="#D4AF37" />
      <!-- Conch Body -->
      <path d="M 0,-58 C 38,-55 52,-20 42,15 C 32,45 10,60 0,72 C -10,60 -32,45 -42,15 C -52,-20 -38,-55 0,-58 Z" 
            fill="#FFFDF5" stroke-width="5" />
      <!-- Inner Spiral Lines -->
      <path d="M -18,-35 C 5,-42 28,-25 22,0 C 16,20 -8,22 -14,5 C -18,-8 -5,-18 5,-10" stroke-width="3.5" stroke-linecap="round" />
      <path d="M -32,-15 C -25,15 -5,35 18,32" stroke-width="2.5" stroke-linecap="round" />
      <!-- Side Tassels -->
      <path d="M -45,-5 Q -68,10 -62,38" stroke-width="3" />
      <path d="M 45,-5 Q 68,10 62,38" stroke-width="3" />
      <!-- Base Pedestal -->
      <path d="M -25,74 L 25,74 L 35,86 L -35,86 Z" fill="#D4AF37" stroke="none" />
    </g>
  </svg>
</div>