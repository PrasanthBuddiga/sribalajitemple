---
import SankalpamCard from './SankalpamCard.astro';
---

<section class="max-w-6xl mx-auto -mt-12 relative z-20 px-4 flex flex-col md:grid md:grid-cols-3 gap-4 md:gap-6">
  <!-- Card 1: Temple Hours + Location -->
  <div class="p-4 md:p-6 rounded-xl bg-white/80 backdrop-blur-lg border border-maroon/20 border-t-4 border-saffron shadow-lg flex flex-col h-full min-h-[220px]">
    <h3 class="text-saffron font-semibold text-base md:text-lg mb-2 md:mb-3 pb-2 md:pb-3 border-b border-maroon/10">🛕 Temple Hours & Location</h3>
    
    <div class="mb-3 md:mb-4 flex-grow">
      <p class="text-ink text-xs md:text-sm font-medium mb-1">Weekdays:</p>
      <p class="text-ink-light text-xs mb-2">10:00 AM – 12:00 PM | 6:00 PM – 8:30 PM</p>
      <p class="text-ink text-xs md:text-sm font-medium mb-1">Weekends:</p>
      <p class="text-ink-light text-xs">10:00 AM – 8:30 PM</p>
    </div>
    
    <div class="border-t border-slate-200 pt-2 md:pt-3">
      <p class="text-ink text-xs md:text-sm mb-1">12501 Bel-Red Rd, Bellevue, WA 98005</p>
      <a href="https://www.google.com/maps/search/?api=1&query=12501+Bel-Red+Rd,+Bellevue,+WA+98005" target="_blank" class="inline-block text-saffron text-xs underline hover:text-maroon">Get Directions →</a>
    </div>
  </div>

  <!-- Card 2: Daily Services -->
  <div class="p-4 md:p-6 rounded-xl bg-white/80 backdrop-blur-lg border border-maroon/20 border-t-4 border-saffron shadow-lg flex flex-col h-full min-h-[220px]">
    <h3 class="text-saffron font-semibold text-base md:text-lg mb-2 md:mb-3 pb-2 md:pb-3 border-b border-maroon/10">🪔 Daily Services</h3>
    <div class="flex-grow flex flex-col justify-center">
      <p class="text-ink text-xs md:text-sm">Archana & Aarati: 11:00 AM & 8:00 PM</p>
      <p class="text-ink text-xs md:text-sm mt-1">Shayana Aarati: 8:25 PM</p>
      <p class="text-ink-light text-xs mt-2">📿 Vishnu Sahasranamam: Sat 6:30 PM</p>
    </div>
  </div>

  <!-- Card 3: Sankalpam (Center) -->
  <SankalpamCard />
</section>
