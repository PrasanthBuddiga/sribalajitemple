<!-- LIGHTBOX MODAL FOR FLYERS -->
<div id="flyerModal" class="fixed inset-0 z-50 hidden bg-maroon/80 backdrop-blur-md flex items-center justify-center p-4">
  <div class="relative max-w-3xl w-full bg-white border border-maroon/20 rounded-2xl p-4 overflow-hidden shadow-2xl">
    <button onclick="closeModal()" class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-cream text-ink hover:text-maroon hover:bg-maroon/10 flex items-center justify-center font-bold transition-colors">
      ✕
    </button>
    <h3 id="modalTitle" class="text-lg font-bold text-ink mb-4 pr-12"></h3>
    <div class="max-h-[80vh] overflow-y-auto rounded-xl">
      <img id="modalImage" src="" alt="Event Flyer" class="w-full h-auto rounded-xl" />
    </div>
  </div>
</div>

<script is:inline>
  function openModal(imgUrl, title) {
    const imgEl = document.getElementById('modalImage');
    const titleEl = document.getElementById('modalTitle');
    const modalEl = document.getElementById('flyerModal');
    
    if (imgEl) imgEl.src = imgUrl;
    if (titleEl) titleEl.innerHTML = title;
    if (modalEl) modalEl.classList.remove('hidden');
  }
  
  function closeModal() {
    const modalEl = document.getElementById('flyerModal');
    if (modalEl) modalEl.classList.add('hidden');
  }
  
  // Close modal on escape key
  document.addEventListener('keydown', (e) => {
    const modalEl = document.getElementById('flyerModal');
    if (e.key === 'Escape' && modalEl && !modalEl.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
