---
const currentPage = Astro.url.pathname;
---

<script is:inline>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden');
  }

  function closeMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  window.toggleMobileMenu = toggleMobileMenu;
  window.closeMobileMenu = closeMobileMenu;
</script>

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/95 backdrop-blur-md border-b border-maroon/20 shadow-sm">
  <nav class="max-w-6xl mx-auto px-4 py-3 md:py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="text-lg md:text-xl font-serif font-bold text-maroon hover:text-saffron transition-colors flex items-center">
      Sri Balaji Temple
    </a>
    
    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      <a 
        href="/" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Home
      </a>
      <a 
        href="/about" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/about' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        About
      </a>
      <a 
        href="/events" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/events' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Events
      </a>
      <a 
        href="/gallery" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/gallery' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Gallery
      </a>
      <a 
        href="/stotras" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/stotras' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Stotras
      </a>
      <a 
        href="/priest-services" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/priest-services' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Services
      </a>
      <a 
        href="/sponsor" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/sponsor' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Sponsor
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      onclick="toggleMobileMenu()" 
      class="md:hidden p-2 rounded-lg hover:bg-maroon/10 transition-colors"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6 text-maroon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-[9999] bg-cream h-screen w-screen">
    <div class="flex flex-col h-full">
      <!-- Mobile Menu Header -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-maroon/20">
        <a href="/" onclick="closeMobileMenu()" class="text-lg font-serif font-bold text-maroon">
          Sri Balaji Temple
        </a>
        <button 
          onclick="closeMobileMenu()" 
          class="p-2 rounded-lg hover:bg-maroon/10 transition-colors"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6 text-maroon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Links -->
      <div class="flex-1 overflow-auto px-4 py-6">
        <div class="space-y-4">
          <a 
            href="/" 
            onclick="closeMobileMenu()"
            class={`block px-4 py-4 rounded-lg font-medium transition-colors ${
              currentPage === '/' 
                ? 'bg-saffron text-white' 
                : 'bg-white/50 text-ink hover:bg-maroon/10'
            }`}
          >
            Home
          </a>
          <a 
            href="/about" 
            onclick="closeMobileMenu()"
            class={`block px-4 py-4 rounded-lg font-medium transition-colors ${
              currentPage === '/about' 
                ? 'bg-saffron text-white' 
                : 'bg-white/50 text-ink hover:bg-maroon/10'
            }`}
          >
            About
          </a>
          <a 
            href="/events" 
            onclick="closeMobileMenu()"
            class={`block px-4 py-4 rounded-lg font-medium transition-colors ${
              currentPage === '/events' 
                ? 'bg-saffron text-white' 
                : 'bg-white/50 text-ink hover:bg-maroon/10'
            }`}
          >
            Events
          </a>
          <a 
            href="/gallery" 
            onclick="closeMobileMenu()"
            class={`block px-4 py-4 rounded-lg font-medium transition-colors ${
              currentPage === '/gallery' 
                ? 'bg-saffron text-white' 
                : 'bg-white/50 text-ink hover:bg-maroon/10'
            }`}
          >
            Gallery
          </a>
          <a 
            href="/stotras" 
            onclick="closeMobileMenu()"
            class={`block px-4 py-4 rounded-lg font-medium transition-colors ${
              currentPage === '/stotras' 
                ? 'bg-saffron text-white' 
                : 'bg-white/50 text-ink hover:bg-maroon/10'
            }`}
          >
            Stotras
          </a>
          <a 
            href="/priest-services" 
            onclick="closeMobileMenu()"
            class={`block px-4 py-4 rounded-lg font-medium transition-colors ${
              currentPage === '/priest-services' 
                ? 'bg-saffron text-white' 
                : 'bg-white/50 text-ink hover:bg-maroon/10'
            }`}
          >
            Services
          </a>
          <a 
            href="/sponsor" 
            onclick="closeMobileMenu()"
            class={`block px-4 py-4 rounded-lg font-medium transition-colors ${
              currentPage === '/sponsor' 
                ? 'bg-saffron text-white' 
                : 'bg-white/50 text-ink hover:bg-maroon/10'
            }`}
          >
            Sponsor
          </a>
        </div>
      </div>

      <!-- Mobile Menu Footer -->
      <div class="px-4 py-4 border-t border-maroon/20">
        <p class="text-center text-ink-light text-sm">
          12501 Bel-Red Rd, Bellevue, WA 98005
        </p>
      </div>
    </div>
  </div>
</header>
