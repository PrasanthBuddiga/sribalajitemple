---
const currentPage = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40 bg-cream/90 backdrop-blur-md border-b border-maroon/20 shadow-sm">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-serif font-bold text-maroon hover:text-saffron transition-colors">
      Sri Balaji Temple
    </a>
    
    <div class="flex items-center gap-4 md:gap-6">
      <a 
        href="/" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Home
      </a>
      <a 
        href="/about" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/about' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        About
      </a>
      <a 
        href="/events" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/events' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Events
      </a>
      <a 
        href="/gallery" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/gallery' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Gallery
      </a>
      <a 
        href="/priest-services" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/priest-services' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Services
      </a>
      <a 
        href="/sponsor" 
        class={`text-sm font-medium transition-colors ${
          currentPage === '/sponsor' ? 'text-saffron' : 'text-ink hover:text-saffron'
        }`}
      >
        Sponsor
      </a>
    </div>
  </nav>
</header>
