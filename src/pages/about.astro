---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us | Sri Balaji Temple">
  <Header />
  
  <div class="pt-24 pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-slate-800 mb-4">About Sri Balaji Temple</h1>
        <p class="text-slate-600 text-lg max-w-2xl mx-auto">
          A spiritual home for devotees in the Pacific Northwest, dedicated to Lord Venkateswara.
        </p>
      </div>

      <!-- Our Story -->
      <section class="mb-16">
        <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-8 shadow-lg">
          <h2 class="text-2xl font-serif font-bold text-slate-800 mb-4">Our Story</h2>
          <p class="text-slate-600 mb-4">
            Sri Balaji Temple of Bellevue, Washington was established to serve the spiritual needs of the growing Hindu community in the Pacific Northwest. Founded with devotion and dedication, the temple has become a beacon of faith, culture, and tradition.
          </p>
          <p class="text-slate-600 mb-4">
            The temple is dedicated to Lord Venkateswara (Balaji), an incarnation of Lord Vishnu, who is worshipped as the preserver and protector of the universe. Our temple follows the traditional South Indian temple architecture and rituals, providing an authentic spiritual experience.
          </p>
          <p class="text-slate-600">
            Over the years, we have grown from a small gathering of devotees to a vibrant community center that offers daily poojas, festivals, cultural programs, educational classes, and community service initiatives.
          </p>
        </div>
      </section>

      <!-- Mission & Vision -->
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-amber-50 border border-amber-200/50 p-6 shadow-lg">
            <h2 class="text-2xl font-serif font-bold text-slate-800 mb-4">Our Mission</h2>
            <p class="text-slate-600">
              To provide a sacred space for worship, spiritual growth, and cultural preservation. We strive to serve the community through religious ceremonies, educational programs, and charitable activities, fostering peace, harmony, and devotion among all.
            </p>
          </div>
          
          <div class="rounded-2xl bg-amber-50 border border-amber-200/50 p-6 shadow-lg">
            <h2 class="text-2xl font-serif font-bold text-slate-800 mb-4">Our Vision</h2>
            <p class="text-slate-600">
              To be a center of spiritual excellence that preserves and promotes Hindu traditions, values, and culture for future generations. We envision a community united in faith, knowledge, and service to humanity.
            </p>
          </div>
        </div>
      </section>

      <!-- What We Offer -->
      <section class="mb-16">
        <h2 class="text-2xl font-serif font-bold text-slate-800 mb-8 text-center">What We Offer</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg text-center">
            <div class="text-4xl mb-3">🛕</div>
            <h3 class="font-semibold text-slate-800 mb-2">Daily Poojas</h3>
            <p class="text-slate-600 text-sm">Regular worship ceremonies throughout the day</p>
          </div>
          
          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg text-center">
            <div class="text-4xl mb-3">🎉</div>
            <h3 class="font-semibold text-slate-800 mb-2">Festival Celebrations</h3>
            <p class="text-slate-600 text-sm">Grand celebrations for major Hindu festivals</p>
          </div>
          
          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg text-center">
            <div class="text-4xl mb-3">📚</div>
            <h3 class="font-semibold text-slate-800 mb-2">Cultural Classes</h3>
            <p class="text-slate-600 text-sm">Music, dance, and language classes for all ages</p>
          </div>
          
          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg text-center">
            <div class="text-4xl mb-3">🙏</div>
            <h3 class="font-semibold text-slate-800 mb-2">Priest Services</h3>
            <p class="text-slate-600 text-sm">Home ceremonies and special occasion services</p>
          </div>
          
          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg text-center">
            <div class="text-4xl mb-3">🍲</div>
            <h3 class="font-semibold text-slate-800 mb-2">Annadanam</h3>
            <p class="text-slate-600 text-sm">Free food distribution to devotees</p>
          </div>
          
          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg text-center">
            <div class="text-4xl mb-3">🤝</div>
            <h3 class="font-semibold text-slate-800 mb-2">Community Service</h3>
            <p class="text-slate-600 text-sm">Charitable activities and outreach programs</p>
          </div>
        </div>
      </section>

      <!-- Temple Timings -->
      <section class="mb-16">
        <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-8 shadow-lg">
          <h2 class="text-2xl font-serif font-bold text-slate-800 mb-6 text-center">Temple Timings</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="font-semibold text-amber-600 mb-3">Weekdays (Mon - Fri)</h3>
              <ul class="text-slate-600 space-y-2">
                <li>Morning: 10:00 AM – 12:00 PM</li>
                <li>Evening: 6:00 PM – 8:30 PM</li>
              </ul>
            </div>
            
            <div>
              <h3 class="font-semibold text-amber-600 mb-3">Weekends (Sat - Sun)</h3>
              <ul class="text-slate-600 space-y-2">
                <li>All Day: 10:00 AM – 8:30 PM</li>
              </ul>
            </div>
          </div>
          
          <div class="mt-6 pt-6 border-t border-amber-200/50">
            <h3 class="font-semibold text-amber-600 mb-3">Daily Pooja Schedule</h3>
            <ul class="text-slate-600 space-y-2">
              <li><strong>Archana & Aarati:</strong> 11:00 AM & 8:00 PM</li>
              <li><strong>Shayana Aarati:</strong> 8:25 PM</li>
            </ul>
          </div>

          <div class="mt-6 pt-6 border-t border-amber-200/50">
            <h3 class="font-semibold text-amber-600 mb-3">Special Events</h3>
            <ul class="text-slate-600 space-y-2">
              <li><strong>Abhishekam:</strong> Every 2nd Saturday @ 10:30 AM</li>
              <li><strong>Vishnu Sahasranamam:</strong> Every Saturday @ 6:30 PM</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Contact Information -->
      <section class="bg-amber-50 rounded-2xl p-8 border border-amber-200/50">
        <h2 class="text-2xl font-serif font-bold text-slate-800 mb-6 text-center">Visit Us</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-semibold text-slate-800 mb-3">Address</h3>
            <p class="text-slate-600 mb-4">
              12501 Bel-Red Rd<br />
              Bellevue, WA 98005
            </p>
            
            <h3 class="font-semibold text-slate-800 mb-3">Contact</h3>
            <p class="text-slate-600 mb-2">
              <strong>Phone:</strong> (425) 555-0123
            </p>
            <p class="text-slate-600 mb-2">
              <strong>Email:</strong> info@sribalajitemple.com
            </p>
          </div>
          
          <div>
            <h3 class="font-semibold text-slate-800 mb-3">Follow Us</h3>
            <div class="flex gap-3 mb-4">
              <a href="https://www.facebook.com/sribalajitempleWA" target="_blank" rel="noopener noreferrer" class="text-amber-600 hover:text-amber-700 transition-colors">
                Facebook
              </a>
              <span class="text-slate-400">|</span>
              <a href="https://www.instagram.com/sribalajitemplewa/" target="_blank" rel="noopener noreferrer" class="text-amber-600 hover:text-amber-700 transition-colors">
                Instagram
              </a>
              <span class="text-slate-400">|</span>
              <a href="https://www.youtube.com/@SriBalajiTempleWA" target="_blank" rel="noopener noreferrer" class="text-amber-600 hover:text-amber-700 transition-colors">
                YouTube
              </a>
            </div>
            
            <a href="https://www.google.com/maps/search/?api=1&query=12501+Bel-Red+Rd,+Bellevue,+WA+98005" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-2 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-medium transition-colors">
              Get Directions
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- FOOTER -->
  <Footer />
</Layout>
