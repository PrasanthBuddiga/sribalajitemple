---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InfoStrip from '../components/InfoStrip.astro';
import EventCard from '../components/EventCard.astro';
import FlyerModal from '../components/FlyerModal.astro';
import Footer from '../components/Footer.astro';
import type { TempleEvent } from '../types/events';

// Fetch events from WordPress API
const WORDPRESS_API_URL = 'https://sribalajitemple.org';
let events: TempleEvent[] = [];
let error: string | null = null;

try {
  const response = await fetch(`${WORDPRESS_API_URL}/wp-json/sribalaji/v1/events`);
  if (!response.ok) {
    throw new Error(`HTTP error! status: ${response.status}`);
  }
  events = await response.json();
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error occurred';
  console.error('Failed to fetch events:', e);
}
---

<Layout>
  <Header />
  
  <!-- HERO SECTION WITH BACKGROUND IMAGE -->
  <header class="relative h-[85vh] md:h-[90vh] w-full flex items-center justify-center pt-16">
    <!-- Background Image - Mobile -->
    <img 
      src="/images/temple-bg-mob.jpg" 
      alt="Sri Balaji Temple" 
      class="absolute inset-0 w-full h-full object-cover object-top md:hidden"
    />
    <!-- Background Image - Desktop -->
    <img 
      src="/images/temple-bg.jpg" 
      alt="Sri Balaji Temple" 
      class="absolute inset-0 w-full h-full object-cover object-center hidden md:block"
    />
    
    <!-- Dark Gradient Overlay for Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>

    <!-- HERO CONTENT -->
    <div class="relative z-10 max-w-4xl mx-4 text-center px-6 md:px-12">
      <!-- <div class="inline-block px-4 py-2 mb-2 rounded-full bg-black/40 backdrop-blur-sm">
        <p class="text-saffron font-semibold text-sm md:text-md tracking-widest uppercase drop-shadow-md">ॐ नमो वेंकटेसाय</p>
      </div> -->
      <h1 class="text-3xl md:text-6xl font-serif font-bold text-white mb-4 drop-shadow-lg">
        Welcome to Sri Balaji Temple
      </h1>
      <p class="text-white/90 text-base md:text-xl max-w-2xl mx-auto mb-8 drop-shadow-md">
        A divine abode of worship, culture, and spiritual peace located in Bellevue, WA.
      </p>
      
      <!-- ACTION BUTTONS -->
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#events" class="px-6 py-3 md:px-8 md:py-4 rounded-full bg-saffron hover:bg-maroon text-white font-semibold transition-all shadow-lg hover:shadow-saffron/30 text-sm md:text-base">
          Upcoming Events
        </a>
        <a href="/sponsor" class="px-6 py-3 md:px-8 md:py-4 rounded-full bg-white/20 hover:bg-white/30 text-white font-medium backdrop-blur-sm border border-white/30 transition-all text-sm md:text-base">
          Sponsor
        </a>
      </div>
    </div>
  </header>

  <!-- QUICK INFO STRIP -->
  <InfoStrip />

  <!-- UPCOMING EVENTS SECTION -->
  <section id="events" class="max-w-6xl mx-auto px-4 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-ink">Upcoming Events & Poojas</h2>
      <p class="text-ink-light mt-2">Click any event card to view the full flyer image.</p>
    </div>

    <!-- EVENT CARDS GRID -->
    {error ? (
      <div class="text-center py-12 bg-red-50 border border-red-200 rounded-2xl">
        <p class="text-red-600 text-lg mb-2">Unable to load events from the temple website.</p>
        <p class="text-red-500 text-sm">Error: {error}</p>
        <p class="text-ink-light text-sm mt-4">Please try again later or contact the temple administrator.</p>
      </div>
    ) : events.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-ink-light text-lg">No events currently scheduled. Please check back soon!</p>
      </div>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/events" class="inline-block px-6 py-3 rounded-lg bg-saffron hover:bg-maroon text-white font-medium transition-colors">
            View All Events
          </a>
        </div>
      </>
    )}
  </section>

  <!-- LIGHTBOX MODAL FOR FLYERS -->
  <FlyerModal />

  <!-- FOOTER -->
  <Footer />
</Layout>
