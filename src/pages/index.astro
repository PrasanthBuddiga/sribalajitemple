---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EventCard from '../components/EventCard.astro';
import FlyerModal from '../components/FlyerModal.astro';
import Footer from '../components/Footer.astro';
import type { TempleEvent } from '../types/events';

// Fetch events from WordPress API
const WORDPRESS_API_URL = 'https://sribalajitemple.org';
let events: TempleEvent[] = [];
let error: string | null = null;

try {
  const response = await fetch(`${WORDPRESS_API_URL}/wp-json/sribalaji/v1/events`);
  if (!response.ok) {
    throw new Error(`HTTP error! status: ${response.status}`);
  }
  events = await response.json();
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error occurred';
  console.error('Failed to fetch events:', e);
}
---

<Layout>
  <Header />
  
  <!-- HERO SECTION WITH BACKGROUND IMAGE -->
  <header class="relative h-[85vh] md:h-[90vh] w-full flex items-center justify-center pt-16">
    <!-- Background Image - Mobile -->
    <img 
      src="/images/temple-bg-mob.jpg" 
      alt="Sri Balaji Temple" 
      class="absolute inset-0 w-full h-full object-cover object-top md:hidden"
    />
    <!-- Background Image - Desktop -->
    <img 
      src="/images/temple-bg.jpg" 
      alt="Sri Balaji Temple" 
      class="absolute inset-0 w-full h-full object-cover object-center hidden md:block"
    />
    
    <!-- Dark Gradient Overlay for Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>

    <!-- HERO CONTENT -->
    <div class="relative z-10 max-w-4xl mx-4 text-center px-6 md:px-12 animate-fade-in-up">
      <h1 class="text-3xl md:text-6xl font-serif font-bold text-white mb-4 drop-shadow-lg">
        Welcome to Sri Balaji Temple
      </h1>
      <p class="text-white/90 text-base md:text-xl max-w-2xl mx-auto mb-8 drop-shadow-md">
        A divine abode of worship, culture, and spiritual peace located in Bellevue, WA.
      </p>
      
      <!-- ACTION BUTTONS -->
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#events" class="px-6 py-3 md:px-8 md:py-4 rounded-[2rem] bg-saffron hover:bg-maroon text-white font-semibold transition-all duration-300 shadow-lg hover:shadow-saffron/30 hover:scale-105 text-sm md:text-base">
          Upcoming Events
        </a>
        <a href="/sponsor" class="px-6 py-3 md:px-8 md:py-4 rounded-[2rem] bg-white/90 hover:bg-white text-amber-950 font-medium backdrop-blur-sm border border-white/40 transition-all duration-300 hover:scale-105 shadow-md text-sm md:text-base cursor-pointer">
          Sponsor
        </a>
      </div>
    </div>
  </header>

  <!-- STYLISH ROUNDED INFO CARDS STRIP -->
  <section class="relative z-20 max-w-6xl mx-auto px-4 sm:px-6 -mt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
      
      <!-- Card 1: Temple Hours & Location -->
      <div class="group relative rounded-[2.25rem] bg-white/90 backdrop-blur-md p-8 border border-amber-900/10 shadow-[0_20px_50px_rgba(139,69,19,0.08)] hover:shadow-[0_28px_60px_rgba(217,119,6,0.16)] hover:-translate-y-2 transition-all duration-500 ease-out flex flex-col justify-between overflow-hidden animate-card-enter" style="animation-delay: 100ms;">
        <div class="pointer-events-none absolute -top-16 -right-16 w-40 h-40 rounded-full bg-gradient-to-br from-amber-400/20 to-orange-500/0 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <div>
          <div class="flex items-center gap-3.5 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-100 to-orange-50 border border-amber-500/20 flex items-center justify-center text-2xl shadow-sm group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
              🛕
            </div>
            <h2 class="text-xl font-serif font-bold text-amber-900 tracking-tight">
              Temple Hours & Location
            </h2>
          </div>

          <div class="space-y-4 text-sm text-stone-600">
            <div class="p-3.5 rounded-2xl bg-amber-50/60 border border-amber-900/5">
              <p class="font-semibold text-stone-800 mb-0.5">Weekdays</p>
              <p class="text-stone-600">10:00 AM – 12:00 PM &nbsp;|&nbsp; 6:00 PM – 8:30 PM</p>
            </div>
            <div class="p-3.5 rounded-2xl bg-amber-50/60 border border-amber-900/5">
              <p class="font-semibold text-stone-800 mb-0.5">Weekends</p>
              <p class="text-stone-600">10:00 AM – 8:30 PM</p>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-5 border-t border-amber-900/10">
          <p class="text-sm font-medium text-stone-700 mb-2">
            12501 Bel-Red Rd, Bellevue, WA 98005
          </p>
          <a
            href="https://maps.google.com/?q=12501+Bel-Red+Rd,+Bellevue,+WA+98005"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-700 hover:text-amber-900 transition-colors group/link"
          >
            <span>Get Directions</span>
            <span class="transform group-hover/link:translate-x-1 transition-transform duration-200">→</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Daily Services -->
      <div class="group relative rounded-[2.25rem] bg-white/90 backdrop-blur-md p-8 border border-amber-900/10 shadow-[0_20px_50px_rgba(139,69,19,0.08)] hover:shadow-[0_28px_60px_rgba(217,119,6,0.16)] hover:-translate-y-2 transition-all duration-500 ease-out flex flex-col justify-between overflow-hidden animate-card-enter" style="animation-delay: 220ms;">
        <div class="pointer-events-none absolute -top-16 -right-16 w-40 h-40 rounded-full bg-gradient-to-br from-amber-400/20 to-orange-500/0 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <div>
          <div class="flex items-center gap-3.5 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-100 to-orange-50 border border-amber-500/20 flex items-center justify-center text-2xl shadow-sm group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300">
              🪔
            </div>
            <h2 class="text-xl font-serif font-bold text-amber-900 tracking-tight">
              Daily Services
            </h2>
          </div>

          <div class="space-y-3 text-sm text-stone-700 mt-8">
            <div class="flex items-center justify-between p-3.5 rounded-2xl bg-amber-50/60 border border-amber-900/5">
              <span class="font-medium text-stone-800">Archana & Aarati</span>
              <span class="font-semibold text-amber-800">11:00 AM & 8:00 PM</span>
            </div>
            <div class="flex items-center justify-between p-3.5 rounded-2xl bg-amber-50/60 border border-amber-900/5">
              <span class="font-medium text-stone-800">Shayana Aarati</span>
              <span class="font-semibold text-amber-800">8:25 PM</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-5 border-t border-amber-900/10 flex items-center gap-2 text-xs font-medium text-stone-600">
          <span class="text-base">🕉️</span>
          <span>Vishnu Sahasranamam: <strong class="text-amber-900">Sat 6:30 PM</strong></span>
        </div>
      </div>

      <!-- Card 3: Today's Sankalpam -->
      <div class="group relative rounded-[2.25rem] bg-white/90 backdrop-blur-md p-8 border border-amber-900/10 shadow-[0_20px_50px_rgba(139,69,19,0.08)] hover:shadow-[0_28px_60px_rgba(217,119,6,0.16)] hover:-translate-y-2 transition-all duration-500 ease-out flex flex-col justify-between overflow-hidden animate-card-enter" style="animation-delay: 340ms;">
        <div class="pointer-events-none absolute -top-16 -right-16 w-40 h-40 rounded-full bg-gradient-to-br from-amber-400/20 to-orange-500/0 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <div>
          <div class="flex items-center gap-3.5 mb-5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-100 to-orange-50 border border-amber-500/20 flex items-center justify-center text-2xl shadow-sm group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
              🕉️
            </div>
            <h2 class="text-xl font-serif font-bold text-amber-900 tracking-tight">
              Today's Sankalpam
            </h2>
          </div>

          <div class="text-center space-y-1.5 py-3 px-3 rounded-2xl bg-gradient-to-b from-amber-50/80 to-orange-50/40 border border-amber-900/5 text-xs text-stone-700">
            <p class="font-semibold text-amber-900 text-sm">Saturday, November 14, 2026</p>
            <p>Parabhava nama samvatsare - Dakshinayanaane</p>
            <p>Hemanta ruthou - Kartika mase</p>
            <p>Shukla pakshe - Panchami tithou</p>
            <p>Shanivara vasare - Uttara nakshatre</p>
            <p class="font-medium text-amber-800">Soola yoge</p>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-amber-900/10 text-center">
          <p class="text-[11px] italic text-stone-400">
            For Bellevue, WA (America/Los_Angeles)
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- UPCOMING EVENTS SECTION -->
  <section id="events" class="max-w-7xl mx-auto px-6 py-16 relative">
    <div class="absolute inset-0 bg-grid-pattern -z-10"></div>
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-ink">Upcoming Events & Poojas</h2>
      <p class="text-ink-light mt-2">Click any event card to view the full flyer image.</p>
    </div>

    <!-- EVENT CARDS GRID -->
    {error ? (
      <div class="text-center py-12 bg-red-50 border border-red-200 rounded-2xl">
        <p class="text-red-600 text-lg mb-2">Unable to load events from the temple website.</p>
        <p class="text-red-500 text-sm">Error: {error}</p>
        <p class="text-ink-light text-sm mt-4">Please try again later or contact the temple administrator.</p>
      </div>
    ) : events.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-ink-light text-lg">No events currently scheduled. Please check back soon!</p>
      </div>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {events.map((event, index) => (
            <div class={`animate-fade-in-up animate-delay-${(index + 1) * 100}`}>
              <EventCard event={event} />
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/events" class="inline-block px-6 py-3 rounded-2xl bg-saffron hover:bg-maroon text-white font-medium transition-all duration-300 shadow-md hover:shadow-lg hover:scale-[1.02]">
            View All Events
          </a>
        </div>
      </>
    )}
  </section>

  <!-- LIGHTBOX MODAL FOR FLYERS -->
  <FlyerModal />

  <!-- FOOTER -->
  <Footer />
</Layout>

<style>
  @keyframes cardEnter {
    0% {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .animate-card-enter {
    opacity: 0;
    animation: cardEnter 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>