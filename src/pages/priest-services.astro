---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Priest Services | Sri Balaji Temple">
  <Header />
  
  <div class="pt-24 pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-slate-800 mb-4">Priest Services</h1>
        <p class="text-slate-600 text-lg max-w-2xl mx-auto">
          Our experienced priests are available to perform various religious ceremonies and poojas for your home, office, or special occasions.
        </p>
      </div>

      <!-- Services List -->
      <section class="mb-16">
        <h2 class="text-2xl font-serif font-bold text-slate-800 mb-8 text-center">Available Services</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">🏠 Gruha Pravesham (House Warming)</h3>
            <p class="text-slate-600 text-sm mb-4">
              Sacred ceremony to bless your new home and bring prosperity to your family.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">💒 Wedding Ceremony (Kalyanam)</h3>
            <p class="text-slate-600 text-sm mb-4">
              Traditional Hindu wedding ceremony performed by our experienced priests.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">🎂 Birthday Pooja</h3>
            <p class="text-slate-600 text-sm mb-4">
              Special pooja for blessings and long life on birthdays and anniversaries.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">🚗 Car Puja</h3>
            <p class="text-slate-600 text-sm mb-4">
              Bless your new vehicle with traditional car puja ceremony for safe travels.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">📿 Satyanarayana Pooja</h3>
            <p class="text-slate-600 text-sm mb-4">
              Perform Satyanarayana Pooja at home for peace, prosperity, and fulfillment of wishes.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">🙏 Namakarana (Naming Ceremony)</h3>
            <p class="text-slate-600 text-sm mb-4">
              Traditional naming ceremony for newborns to bless them with a prosperous life.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">🔥 Homam & Havan</h3>
            <p class="text-slate-600 text-sm mb-4">
              Sacred fire rituals for various purposes including health, wealth, and spiritual growth.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-slate-800 mb-3">⚰️ Last Rites (Antyesti)</h3>
            <p class="text-slate-600 text-sm mb-4">
              Compassionate assistance with funeral ceremonies and last rites for departed souls.
            </p>
            <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 font-medium transition-colors text-sm">
              Book Service
            </a>
          </div>
        </div>
      </section>

      <!-- Additional Services -->
      <section class="mb-16">
        <h2 class="text-2xl font-serif font-bold text-slate-800 mb-8 text-center">Other Services</h2>
        
        <div class="rounded-2xl bg-white/80 border border-amber-200/50 p-8 shadow-lg">
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 text-slate-600">
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Ayush Homam (for newborns)</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Anna Prasanam (first solid food)</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Vidyarambham (education initiation)</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Upanayanam (sacred thread ceremony)</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Shanti Pooja (peace ceremony)</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Dhanvantari Pooja (health)</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Saraswati Pooja (education)</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-600 mr-2">✓</span>
              <span>Lakshmi Pooja (wealth)</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Booking Information -->
      <section class="bg-amber-50 rounded-2xl p-8 border border-amber-200/50">
        <h2 class="text-2xl font-serif font-bold text-slate-800 mb-4 text-center">How to Book</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          <div>
            <div class="w-12 h-12 rounded-full bg-amber-500 mx-auto mb-3 flex items-center justify-center text-white font-bold">1</div>
            <h3 class="font-semibold text-slate-800 mb-2">Choose Service</h3>
            <p class="text-slate-600 text-sm">Select the ceremony you need from our available services</p>
          </div>
          <div>
            <div class="w-12 h-12 rounded-full bg-amber-500 mx-auto mb-3 flex items-center justify-center text-white font-bold">2</div>
            <h3 class="font-semibold text-slate-800 mb-2">Contact Us</h3>
            <p class="text-slate-600 text-sm">Call or email to schedule and discuss requirements</p>
          </div>
          <div>
            <div class="w-12 h-12 rounded-full bg-amber-500 mx-auto mb-3 flex items-center justify-center text-white font-bold">3</div>
            <h3 class="font-semibold text-slate-800 mb-2">Complete Booking</h3>
            <p class="text-slate-600 text-sm">Confirm date, time, and complete payment online</p>
          </div>
        </div>
        
        <div class="mt-8 text-center">
          <a href="https://www.sribalajitemple.com/priest-services/" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-semibold transition-colors">
            Book a Priest Service
          </a>
        </div>
      </section>
    </div>
  </div>

  <!-- FOOTER -->
  <Footer />
</Layout>
