---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<script is:inline>
  function openForm() {
    document.getElementById('jotform-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeForm() {
    document.getElementById('jotform-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  window.openForm = openForm;
  window.closeForm = closeForm;
</script>

<Layout title="Priest Services | Sri Balaji Temple">
  <Header />
  
  <div class="pt-20 md:pt-24 pb-16 md:pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-ink mb-4">Priest Services</h1>
        <p class="text-ink-light text-lg max-w-2xl mx-auto">
          Our experienced priests are available to perform various religious ceremonies and poojas for your home, office, or special occasions.
        </p>
      </div>

      <!-- Services List -->
      <section class="mb-16">
        <h2 class="text-2xl font-serif font-bold text-ink mb-8 text-center">Available Services</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">🏠 Gruha Pravesham (House Warming)</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Sacred ceremony to bless your new home and bring prosperity to your family.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">💒 Wedding Ceremony (Kalyanam)</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Traditional Hindu wedding ceremony performed by our experienced priests.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">🎂 Birthday Pooja</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Special pooja for blessings and long life on birthdays and anniversaries.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">🚗 Car Puja</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Bless your new vehicle with traditional car puja ceremony for safe travels.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">📿 Satyanarayana Pooja</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Perform Satyanarayana Pooja at home for peace, prosperity, and fulfillment of wishes.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">🙏 Namakarana (Naming Ceremony)</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Traditional naming ceremony for newborns to bless them with a prosperous life.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">🔥 Homam & Havan</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Sacred fire rituals for various purposes including health, wealth, and spiritual growth.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg flex flex-col h-full">
            <h3 class="text-lg font-bold text-ink mb-3">⚰️ Last Rites (Antyesti)</h3>
            <p class="text-ink-light text-sm mb-4 flex-grow">
              Compassionate assistance with funeral ceremonies and last rites for departed souls.
            </p>
            <button onclick="openForm()" class="inline-block px-4 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors text-sm cursor-pointer">
              Book Service
            </button>
          </div>
        </div>
      </section>

      <!-- Additional Services -->
      <section class="mb-16">
        <h2 class="text-2xl font-serif font-bold text-ink mb-8 text-center">Other Services</h2>
        
        <div class="rounded-2xl bg-white/80 border border-maroon/20 p-8 shadow-lg">
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 text-ink-light">
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Ayush Homam (for newborns)</span>
            </li>
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Anna Prasanam (first solid food)</span>
            </li>
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Vidyarambham (education initiation)</span>
            </li>
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Upanayanam (sacred thread ceremony)</span>
            </li>
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Shanti Pooja (peace ceremony)</span>
            </li>
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Dhanvantari Pooja (health)</span>
            </li>
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Saraswati Pooja (education)</span>
            </li>
            <li class="flex items-start">
              <span class="text-saffron mr-2">✓</span>
              <span>Lakshmi Pooja (wealth)</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Booking Information -->
      <section class="bg-cream rounded-2xl p-8 border border-maroon/20">
        <h2 class="text-2xl font-serif font-bold text-ink mb-4 text-center">How to Book</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          <div>
            <div class="w-12 h-12 rounded-full bg-saffron mx-auto mb-3 flex items-center justify-center text-white font-bold">1</div>
            <h3 class="font-semibold text-ink mb-2">Choose Service</h3>
            <p class="text-ink-light text-sm">Select the ceremony you need from our available services</p>
          </div>
          <div>
            <div class="w-12 h-12 rounded-full bg-saffron mx-auto mb-3 flex items-center justify-center text-white font-bold">2</div>
            <h3 class="font-semibold text-ink mb-2">Contact Us</h3>
            <p class="text-ink-light text-sm">Call or email to schedule and discuss requirements</p>
          </div>
          <div>
            <div class="w-12 h-12 rounded-full bg-saffron mx-auto mb-3 flex items-center justify-center text-white font-bold">3</div>
            <h3 class="font-semibold text-ink mb-2">Complete Booking</h3>
            <p class="text-ink-light text-sm">Confirm date, time, and complete payment online</p>
          </div>
        </div>
        
        <div class="mt-8 text-center">
          <button onclick="openForm()" class="inline-block px-8 py-3 rounded-lg bg-saffron hover:bg-maroon text-white font-semibold transition-colors cursor-pointer">
            Book a Priest Service
          </button>
        </div>
      </section>

      <!-- JotForm Modal -->
      <div id="jotform-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-0 md:p-4 bg-black/50 backdrop-blur-sm">
        <div class="bg-white md:rounded-2xl shadow-2xl max-w-4xl w-full h-full md:max-h-[90vh] overflow-hidden flex flex-col">
          <div class="flex items-center justify-between p-4 border-b border-maroon/20">
            <h3 class="text-lg md:text-xl font-bold text-ink">Book a Priest Service</h3>
            <button onclick="closeForm()" class="text-ink-light hover:text-maroon transition-colors text-2xl font-bold cursor-pointer">
              ✕
            </button>
          </div>
          <div class="flex-1 overflow-auto p-0 md:p-4">
            <script type="text/javascript" src="https://form.jotform.com/jsform/253300891101141" async></script>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <Footer />
</Layout>
