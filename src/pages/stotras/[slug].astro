---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const stotras = await getCollection('stotras');
  
  return stotras.map((entry) => ({
    params: { slug: entry.slug || entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;

const slugKey = entry.slug || entry.id;
const contentDir = path.join(process.cwd(), 'src/content/stotras', slugKey);

const languages = ['sanskrit', 'transliteration', 'telugu', 'kannada', 'tamil'];

const languageNames = {
  sanskrit: 'संस्कृतम्',          // Sanskrit in Devanagari script
  transliteration: 'English (IAST)', // Keep clear for English readers
  telugu: 'తెలుగు',             // Telugu script
  kannada: 'ಕನ್ನಡ',             // Kannada script
  tamil: 'தமிழ்'                // Tamil script
};

const stotraContentMap: Record<string, string> = {};
for (const lang of languages) {
  try {
    const filePath = path.join(contentDir, `${lang}.txt`);
    stotraContentMap[lang] = fs.readFileSync(filePath, 'utf-8');
  } catch (e) {
    stotraContentMap[lang] = 'Content not available in this language yet.';
  }
}
---

<Layout title={`${data.title} | Sri Balaji Temple`}>
  <Header />
  
  <div class="pt-24 md:pt-28 pb-20 md:pb-24 px-4 sm:px-6 relative">
    <div class="absolute inset-0 bg-grid-pattern -z-10 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto">
      
      <!-- Back Button -->
      <a 
        href="/stotras"
        class="inline-flex items-center gap-2 mb-6 px-5 py-2.5 rounded-full bg-white/90 backdrop-blur-md border border-amber-900/10 hover:border-saffron/40 hover:bg-amber-50/60 transition-all text-sm font-semibold text-amber-950 shadow-sm"
      >
        <span>←</span>
        <span>Back to All Stotras</span>
      </a>

      <!-- Stotra Header Card -->
      <div class="rounded-[2.25rem] bg-white/90 backdrop-blur-md border border-amber-900/10 border-t-4 border-saffron p-6 md:p-8 shadow-[0_20px_50px_rgba(139,69,19,0.08)] mb-6">
        <h1 class="text-2xl md:text-4xl font-serif font-bold text-amber-950 mb-3">{data.title}</h1>
        <p class="text-stone-600 text-sm md:text-base leading-relaxed">{data.description}</p>
      </div>

      <!-- Controls Bar -->
      <div id="controlsBar" class="rounded-[2rem] bg-white/90 backdrop-blur-md border border-amber-900/10 p-5 md:p-6 shadow-[0_15px_40px_rgba(139,69,19,0.06)] mb-6">
        <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
          <!-- Language Switcher -->
          <div class="flex flex-wrap gap-2 justify-center md:justify-start">
            {languages.map(lang => (
              <button
                type="button"
                id={`lang-btn-${lang}`}
                onclick={`changeLanguage('${lang}')`}
                class={`px-4 py-2 rounded-full border transition-all duration-300 text-sm font-semibold cursor-pointer ${
                  lang === 'sanskrit' 
                    ? 'bg-saffron text-white border-saffron shadow-sm' 
                    : 'bg-amber-50/50 border-amber-900/10 text-stone-700 hover:bg-amber-100/70 hover:border-amber-500/30'
                }`}
              >
                {languageNames[lang]}
              </button>
            ))}
          </div>

          <!-- Font Size Controls -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="decreaseFontSize()"
              class="px-4 py-2 rounded-full border border-amber-900/10 bg-amber-50/50 hover:bg-amber-100/70 text-stone-800 transition-colors font-bold text-sm cursor-pointer"
              aria-label="Decrease font size"
            >
              A-
            </button>
            <button
              type="button"
              onclick="increaseFontSize()"
              class="px-4 py-2 rounded-full border border-amber-900/10 bg-amber-50/50 hover:bg-amber-100/70 text-stone-800 transition-colors font-bold text-sm cursor-pointer"
              aria-label="Increase font size"
            >
              A+
            </button>
          </div>
        </div>
      </div>

      <!-- Stotra Content Display Card -->
      <div class="rounded-[2.25rem] bg-white/90 backdrop-blur-md border border-amber-900/10 p-8 md:p-10 shadow-[0_20px_50px_rgba(139,69,19,0.08)]">
        <div
          id="stotraContent"
          class="stotra-content prose prose-lg max-w-none leading-relaxed whitespace-pre-line font-serif text-lg md:text-xl text-stone-800"
        >
          {stotraContentMap['sanskrit']}
        </div>
      </div>

    </div>
  </div>

  <Footer />

  <script define:vars={{ stotraContentMap }}>
    let currentFontSize = 19;

    function changeLanguage(language) {
      const contentBox = document.getElementById('stotraContent');
      if (stotraContentMap[language]) {
        contentBox.textContent = stotraContentMap[language];

        // Update active button styles
        document.querySelectorAll('[id^="lang-btn-"]').forEach(btn => {
          btn.classList.remove('bg-saffron', 'text-white', 'border-saffron', 'shadow-sm');
          btn.classList.add('bg-amber-50/50', 'border-amber-900/10', 'text-stone-700');
        });
        const activeBtn = document.getElementById(`lang-btn-${language}`);
        if (activeBtn) {
          activeBtn.classList.add('bg-saffron', 'text-white', 'border-saffron', 'shadow-sm');
          activeBtn.classList.remove('bg-amber-50/50', 'border-amber-900/10', 'text-stone-700');
        }
      }
    }

    function increaseFontSize() {
      if (currentFontSize < 32) {
        currentFontSize += 2;
        document.getElementById('stotraContent').style.fontSize = currentFontSize + 'px';
      }
    }

    function decreaseFontSize() {
      if (currentFontSize > 14) {
        currentFontSize -= 2;
        document.getElementById('stotraContent').style.fontSize = currentFontSize + 'px';
      }
    }

    window.changeLanguage = changeLanguage;
    window.increaseFontSize = increaseFontSize;
    window.decreaseFontSize = decreaseFontSize;
  </script>
</Layout>