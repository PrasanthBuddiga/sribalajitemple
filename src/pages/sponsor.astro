---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Sponsorship | Sri Balaji Temple">
  <Header />
  
  <div class="pt-24 pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-ink mb-4">Support Sri Balaji Temple</h1>
        <p class="text-ink-light text-lg max-w-2xl mx-auto">
          Your generous contributions help us maintain the temple, conduct daily poojas, and organize cultural events for the community.
        </p>
      </div>

      <!-- Sponsorship Tiers -->
      <section class="mb-16">
        <h2 class="text-2xl font-serif font-bold text-ink mb-8 text-center">Sponsorship Opportunities</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Bronze Tier -->
          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg text-center">
            <div class="w-16 h-16 rounded-full bg-[#8B4513] mx-auto mb-4 flex items-center justify-center">
              <span class="text-2xl">🥉</span>
            </div>
            <h3 class="text-xl font-bold text-ink mb-2">Bronze Sponsor</h3>
            <p class="text-[#8B4513] font-semibold text-2xl mb-4">$500</p>
            <ul class="text-ink-light text-sm space-y-2 mb-6">
              <li>✓ Name on website</li>
              <li>✓ Tax deduction receipt</li>
              <li>✓ Invitations to major events</li>
            </ul>
            <a href="https://www.sribalajitemple.com/sponsor/" target="_blank" rel="noopener noreferrer" class="inline-block w-full py-3 rounded-lg bg-[#8B4513] hover:bg-[#6B3503] text-white font-medium transition-colors">
              Become a Sponsor
            </a>
          </div>

          <!-- Silver Tier -->
          <div class="rounded-2xl bg-white/80 border border-maroon/30 p-6 shadow-lg text-center transform md:scale-105">
            <div class="w-16 h-16 rounded-full bg-[#71797E] mx-auto mb-4 flex items-center justify-center">
              <span class="text-2xl">🥈</span>
            </div>
            <h3 class="text-xl font-bold text-ink mb-2">Silver Sponsor</h3>
            <p class="text-[#71797E] font-semibold text-2xl mb-4">$1,000</p>
            <ul class="text-ink-light text-sm space-y-2 mb-6">
              <li>✓ All Bronze benefits</li>
              <li>✓ Name on temple display</li>
              <li>✓ Special pooja sponsorship</li>
              <li>✓ Family photo with deity</li>
            </ul>
            <a href="https://www.sribalajitemple.com/sponsor/" target="_blank" rel="noopener noreferrer" class="inline-block w-full py-3 rounded-lg bg-[#71797E] hover:bg-[#5A6368] text-white font-medium transition-colors">
              Become a Sponsor
            </a>
          </div>

          <!-- Gold Tier -->
          <div class="rounded-2xl bg-white/80 border border-maroon/40 p-6 shadow-lg text-center">
            <div class="w-16 h-16 rounded-full bg-[#D4AF37] mx-auto mb-4 flex items-center justify-center">
              <span class="text-2xl">🥇</span>
            </div>
            <h3 class="text-xl font-bold text-ink mb-2">Gold Sponsor</h3>
            <p class="text-[#D4AF37] font-semibold text-2xl mb-4">$2,500+</p>
            <ul class="text-ink-light text-sm space-y-2 mb-6">
              <li>✓ All Silver benefits</li>
              <li>✓ Annual sponsorship plaque</li>
              <li>✓ VIP seating at events</li>
              <li>✓ Private temple tour</li>
              <li>✓ Annual family archana</li>
            </ul>
            <a href="https://www.sribalajitemple.com/sponsor/" target="_blank" rel="noopener noreferrer" class="inline-block w-full py-3 rounded-lg bg-[#D4AF37] hover:bg-[#B8941F] text-white font-medium transition-colors">
              Become a Sponsor
            </a>
          </div>
        </div>
      </section>

      <!-- Other Donation Options -->
      <section class="mb-16">
        <h2 class="text-2xl font-serif font-bold text-ink mb-8 text-center">Other Ways to Give</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-ink mb-3">🪔 Annadanam (Food Donation)</h3>
            <p class="text-ink-light text-sm mb-4">
              Sponsor free meals for devotees on special occasions. Your contribution helps feed the community.
            </p>
            <p class="text-saffron font-semibold mb-4">Starting at $250</p>
            <a href="https://www.sribalajitemple.com/sponsor/" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors">
              Learn More
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-ink mb-3">🌸 Archana Sponsorship</h3>
            <p class="text-ink-light text-sm mb-4">
              Sponsor daily archana (worship) in your family's name. Blessings for you and your loved ones.
            </p>
            <p class="text-saffron font-semibold mb-4">Starting at $100</p>
            <a href="https://www.sribalajitemple.com/sponsor/" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors">
              Learn More
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-ink mb-3">🎉 Event Sponsorship</h3>
            <p class="text-ink-light text-sm mb-4">
              Sponsor major festivals and cultural events. Your support makes our celebrations possible.
            </p>
            <p class="text-saffron font-semibold mb-4">Custom amount</p>
            <a href="https://www.sribalajitemple.com/sponsor/" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors">
              Learn More
            </a>
          </div>

          <div class="rounded-2xl bg-white/80 border border-maroon/20 p-6 shadow-lg">
            <h3 class="text-lg font-bold text-ink mb-3">🏛️ Temple Maintenance</h3>
            <p class="text-ink-light text-sm mb-4">
              Contribute to temple maintenance, renovations, and infrastructure improvements.
            </p>
            <p class="text-saffron font-semibold mb-4">Any amount</p>
            <a href="https://www.sribalajitemple.com/sponsor/" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-2 rounded-lg bg-cream hover:bg-maroon/10 text-maroon font-medium transition-colors">
              Learn More
            </a>
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="bg-cream rounded-2xl p-8 border border-maroon/20">
        <h2 class="text-2xl font-serif font-bold text-ink mb-4 text-center">Questions About Sponsorship?</h2>
        <p class="text-ink-light text-center mb-6">
          Our temple management team is happy to discuss sponsorship opportunities and answer any questions you may have.
        </p>
        <div class="text-center">
          <p class="text-ink mb-2">
            <strong>Email:</strong> sponsor@sribalajitemple.com
          </p>
          <p class="text-ink mb-2">
            <strong>Phone:</strong> (425) 555-0123
          </p>
          <p class="text-ink">
            <strong>Address:</strong> 12501 Bel-Red Rd, Bellevue, WA 98005
          </p>
        </div>
      </section>
    </div>
  </div>

  <!-- FOOTER -->
  <Footer />
</Layout>
