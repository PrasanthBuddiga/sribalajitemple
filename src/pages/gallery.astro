---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import GalleryAlbum from '../components/GalleryAlbum.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import Footer from '../components/Footer.astro';
import type { GalleryAlbum, TempleVideo } from '../types/events';

// Fetch gallery from WordPress API
const WORDPRESS_API_URL = 'https://sribalajitemple.org';
let galleryAlbums: GalleryAlbum[] = [];
let videos: TempleVideo[] = [];
let error: string | null = null;

try {
  // Fetch gallery albums
  const galleryResponse = await fetch(`${WORDPRESS_API_URL}/wp-json/sribalaji/v1/gallery`);
  if (!galleryResponse.ok) {
    throw new Error(`HTTP error! status: ${galleryResponse.status}`);
  }
  galleryAlbums = await galleryResponse.json();

  // Fetch videos
  const videosResponse = await fetch(`${WORDPRESS_API_URL}/wp-json/sribalaji/v1/videos`);
  if (!videosResponse.ok) {
    throw new Error(`HTTP error! status: ${videosResponse.status}`);
  }
  videos = await videosResponse.json();
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error occurred';
  console.error('Failed to fetch gallery or videos:', e);
}

// Transform gallery albums to match GalleryAlbum component format
const albumsForComponent = galleryAlbums.map(album => ({
  title: album.title,
  photos: album.image_urls.map(url => ({
    url: url,
    alt: album.title
  }))
}));

// Helper function to extract YouTube ID from URL
function getYouTubeId(url: string): string {
  const regex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
  const match = url.match(regex);
  return match ? match[1] : '';
}

// Helper function to fetch YouTube title using oEmbed API
async function getYouTubeTitle(youtubeUrl: string): Promise<string | null> {
  try {
    const response = await fetch(`https://www.youtube.com/oembed?url=${encodeURIComponent(youtubeUrl)}&format=json`);
    if (!response.ok) {
      return null;
    }
    const data = await response.json();
    return data.title || null;
  } catch (e) {
    console.error('Failed to fetch YouTube title:', e);
    return null;
  }
}

// Transform videos to extract YouTube IDs and fetch YouTube titles
// Note: YouTube oEmbed doesn't provide descriptions, so we keep WordPress description
const videosWithMetadata = await Promise.all(videos.map(async (video) => {
  const youtubeId = getYouTubeId(video.youtube_url);
  const youtubeTitle = await getYouTubeTitle(video.youtube_url);
  
  return {
    ...video,
    youtubeId,
    title: youtubeTitle || video.title, // Use YouTube title if available, otherwise WordPress title
    description: video.description // Keep WordPress description (oEmbed doesn't provide descriptions)
  };
}));
---

<Layout title="Gallery | Sri Balaji Temple">
  <Header />
  
  <div class="pt-20 md:pt-24 pb-16 md:pb-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-ink mb-4">Photo & Video Gallery</h1>
        <p class="text-ink-light text-lg max-w-2xl mx-auto">
          Explore our collection of memorable moments from temple festivals, celebrations, and cultural events.
        </p>
      </div>

      <!-- PHOTO GALLERY SECTION -->
      <section class="mb-20">
        <h2 class="text-2xl font-serif font-bold text-ink mb-8">Photo Albums</h2>
        
        {error ? (
          <div class="text-center py-12 bg-red-50 border border-red-200 rounded-2xl">
            <p class="text-red-600 text-lg mb-2">Unable to load gallery from the temple website.</p>
            <p class="text-red-500 text-sm">Error: {error}</p>
            <p class="text-ink-light text-sm mt-4">Please try again later or contact the temple administrator.</p>
          </div>
        ) : albumsForComponent.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-ink-light text-lg">No gallery items available. Please check back soon!</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {albumsForComponent.map((album) => (
              <GalleryAlbum title={album.title} photos={album.photos} />
            ))}
          </div>
        )}
      </section>

      <!-- VIDEO GALLERY SECTION -->
      <section>
        <h2 class="text-2xl font-serif font-bold text-ink mb-8">Video Gallery</h2>
        
        {error ? (
          <div class="text-center py-12 bg-red-50 border border-red-200 rounded-2xl">
            <p class="text-red-600 text-lg mb-2">Unable to load videos from the temple website.</p>
            <p class="text-red-500 text-sm">Error: {error}</p>
            <p class="text-ink-light text-sm mt-4">Please try again later or contact the temple administrator.</p>
          </div>
        ) : videosWithMetadata.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-ink-light text-lg">No videos available. Please check back soon!</p>
          </div>
        ) : (
          <div class="relative">
            <!-- Carousel Container -->
            <div id="video-carousel" class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide pb-4" style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;">
              {videosWithMetadata.map((video) => (
                <div class="flex-shrink-0 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] snap-start">
                  <div class="rounded-2xl bg-white/80 border border-maroon/20 overflow-hidden shadow-lg h-full flex flex-col">
                    <div class="aspect-video">
                      <iframe
                        src={`https://www.youtube.com/embed/${video.youtubeId}`}
                        title={video.title}
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        class="w-full h-full"
                      ></iframe>
                    </div>
                    <div class="p-6 flex-1 flex flex-col">
                      <h3 class="text-lg font-bold text-ink mb-2 line-clamp-2">{video.title}</h3>
                      <p class="text-ink-light text-sm line-clamp-3 flex-grow">{video.description}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Navigation Arrows -->
            <button 
              onclick="scrollCarousel('left')"
              class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/2 z-10 w-12 h-12 rounded-full bg-white/90 backdrop-blur-md text-maroon hover:bg-saffron hover:text-white flex items-center justify-center font-bold transition-all duration-300 shadow-lg border border-maroon/20 hidden md:flex"
              aria-label="Previous videos"
            >
              ←
            </button>
            <button 
              onclick="scrollCarousel('right')"
              class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 z-10 w-12 h-12 rounded-full bg-white/90 backdrop-blur-md text-maroon hover:bg-saffron hover:text-white flex items-center justify-center font-bold transition-all duration-300 shadow-lg border border-maroon/20 hidden md:flex"
              aria-label="Next videos"
            >
              →
            </button>
          </div>
        )}
      </section>
    </div>
  </div>

  <!-- GALLERY LIGHTBOX -->
  <GalleryLightbox albums={albumsForComponent} />

  <!-- FOOTER -->
  <Footer />

  <script is:inline>
    function scrollCarousel(direction) {
      const carousel = document.getElementById('video-carousel');
      if (!carousel) {
        console.error('Carousel element not found');
        return;
      }
      
      const scrollAmount = carousel.clientWidth;
      
      if (direction === 'left') {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    }

    window.scrollCarousel = scrollCarousel;
  </script>
</Layout>
