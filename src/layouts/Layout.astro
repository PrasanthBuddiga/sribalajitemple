---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Sri Balaji Temple | Bellevue, WA' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body class="bg-cream text-ink min-h-screen font-sans antialiased selection:bg-saffron selection:text-white">
  <slot />
</body>
</html>
